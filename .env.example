# ============================================================
# YT Deluxe — Environment Variables Template
# ============================================================
# HOW TO USE:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in your values
#   3. Never commit .env to Git (already in .gitignore)
# ============================================================


# ── FRONTEND (Vite) ──────────────────────────────────────────
# Backend API URL which frontend uses to send requests to.
# Desktop app:  http://127.0.0.1:8000
# Web dev mode: http://localhost:8000
VITE_API_BASE_URL=http://127.0.0.1:8000


# ── BACKEND (FastAPI) ────────────────────────────────────────
YTDELUXE_DESKTOP=false